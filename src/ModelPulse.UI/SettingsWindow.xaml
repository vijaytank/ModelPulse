<Window x:Class="ModelPulse.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModelPulse Settings"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Inter, Outfit, Segoe UI">

    <Window.Resources>
        <!-- Base card border -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="BorderBrush" Value="#2A2A30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Label text -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BBBBCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value text -->
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Modern radio button style for polling mode -->
        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#22FFFFFF" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33512BD4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF512BD4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox style for number inputs -->
        <Style x:Key="NumericInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle CheckBox -->
        <Style x:Key="ToggleCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Action button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Save button -->
        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#CC512BD4"/>
            <Setter Property="BorderBrush" Value="#FF512BD4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Slider style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="#FF512BD4"/>
            <Setter Property="Height" Value="20"/>
        </Style>
    </Window.Resources>

    <!-- Outer rounded frame -->
    <Border Background="#0D0D10" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="20,16">

            <!-- ══ Title Bar ══════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="16" Foreground="#FF512BD4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ModelPulse Settings" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CloseButton" Content="✕" Style="{StaticResource ActionButton}"
                        Padding="8,4" Click="CloseButton_Click"/>
            </Grid>

            <!-- ══ POLLING ════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="POLLING" Style="{StaticResource SectionHeader}"/>

                    <!-- Mode selector -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="ModeDefault" Content="Default" Style="{StaticResource ModeButton}"
                                     GroupName="PollingMode" Checked="PollingMode_Checked"/>
                        <RadioButton x:Name="ModeLowPower" Content="Low-Power" Style="{StaticResource ModeButton}"
                                     GroupName="PollingMode" Checked="PollingMode_Checked"/>
                        <RadioButton x:Name="ModeCustom" Content="Custom" Style="{StaticResource ModeButton}"
                                     GroupName="PollingMode" Checked="PollingMode_Checked"/>
                    </StackPanel>

                    <!-- Custom mode fields (visible only in Custom) -->
                    <StackPanel x:Name="CustomPollingPanel" Visibility="Collapsed">
                        <!-- Warning banner -->
                        <Border Background="#22F59E0B" BorderBrush="#44F59E0B" BorderThickness="1"
                                CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                            <TextBlock Text="⚠  Higher polling rates increase CPU, memory, and network overhead."
                                       Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                        <!-- Idle interval -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Idle interval" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="IdleMsBox" Style="{StaticResource NumericInput}"
                                     TextChanged="IntervalBox_TextChanged"/>
                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                        </Grid>
                        <!-- Active interval -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Active interval" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="ActiveMsBox" Style="{StaticResource NumericInput}"
                                     TextChanged="IntervalBox_TextChanged"/>
                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                        </Grid>
                        <!-- Reset defaults -->
                        <Button Content="Reset to Defaults" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                Click="ResetPollingDefaults_Click"/>
                    </StackPanel>

                    <!-- Summary line for Default/Low-Power -->
                    <TextBlock x:Name="PollingSummary" Style="{StaticResource FieldLabel}"
                               Foreground="#8888AA" FontSize="11" Margin="0,4,0,0"
                               Text="Idle: 3 000 ms  |  Active: 1 000 ms"/>
                </StackPanel>
            </Border>

            <!-- ══ DISPLAY ════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="DISPLAY" Style="{StaticResource SectionHeader}"/>
                    <!-- Opacity slider row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Overlay opacity" Style="{StaticResource FieldLabel}"/>
                        <Slider Grid.Column="1" x:Name="OpacitySlider" Style="{StaticResource ModernSlider}"
                                Minimum="10" Maximum="100" SmallChange="5" LargeChange="10"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="OpacityLabel" Text="90%"
                                   Style="{StaticResource FieldValue}" HorizontalAlignment="Right"/>
                    </Grid>
                    <CheckBox x:Name="AlwaysOnTopCheck" Content="Always on top"
                              Style="{StaticResource ToggleCheck}"/>
                    <CheckBox x:Name="LaunchOnStartupCheck" Content="Launch overlay on startup"
                              Style="{StaticResource ToggleCheck}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══ RUNTIMES ═══════════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="RUNTIMES" Style="{StaticResource SectionHeader}"/>
                    <!-- Ollama row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="OllamaEnabledCheck" Content="Ollama"
                                  Style="{StaticResource ToggleCheck}" VerticalAlignment="Center"
                                  MinWidth="90"/>
                        <TextBox Grid.Column="1" x:Name="OllamaEndpointBox" Style="{StaticResource NumericInput}"
                                 Width="Auto" HorizontalAlignment="Stretch" TextAlignment="Left"
                                 Padding="8,4" FontSize="11"/>
                    </Grid>
                    <!-- llama.cpp row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="LlamaCppEnabledCheck" Content="llama.cpp"
                                  Style="{StaticResource ToggleCheck}" VerticalAlignment="Center"
                                  MinWidth="90"/>
                        <TextBox Grid.Column="1" x:Name="LlamaCppEndpointBox" Style="{StaticResource NumericInput}"
                                 Width="Auto" HorizontalAlignment="Stretch" TextAlignment="Left"
                                 Padding="8,4" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ ALERTS ══════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="ALERTS" Style="{StaticResource SectionHeader}"/>
                    <!-- VRAM threshold -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="VRAM warning threshold" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="VramThresholdBox" Style="{StaticResource NumericInput}"
                                 Width="60"/>
                        <TextBlock Grid.Column="2" Text="%" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                    </Grid>
                    <!-- Cooldown -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Alert cooldown" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="CooldownBox" Style="{StaticResource NumericInput}"
                                 Width="60"/>
                        <TextBlock Grid.Column="2" Text="seconds" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Action Row ══════════════════════════════════════════════ -->
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ValidationMessage" Grid.Column="0"
                           Foreground="#FF6B6B" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource ActionButton}"
                        Click="Cancel_Click"/>
                <Button Grid.Column="3" Content="Save &amp; Apply" Style="{StaticResource SaveButton}"
                        Click="Save_Click"/>
            </Grid>

        </StackPanel>
    </Border>

    <!-- Allow dragging the settings window -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>
</Window>
