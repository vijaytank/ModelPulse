<Window x:Class="ModelPulse.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ModelPulse Overlay" 
        Height="420" Width="300"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        FontFamily="Inter, Outfit, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <Style x:Key="OverlayCard" TargetType="Border">
            <Setter Property="Background" Value="#E5101012" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
        </Style>
        
        <Style x:Key="StatProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF512BD4" />
        </Style>

        <Style x:Key="ModernTabButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" BorderThickness="0 0 0 2" BorderBrush="Transparent" Padding="8 4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF00FFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="#88FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="4 2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 1. COMPACT OVERLAY VIEW -->
        <Border Style="{StaticResource OverlayCard}" 
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Width="280" Height="75" Margin="10"
                Cursor="Hand" MouseLeftButtonDown="CompactOverlay_Click"
                Visibility="{Binding CompactVisibility}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Close Button in top right of Compact Overlay -->
                <Button Content="×" 
                        HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Background="Transparent" BorderThickness="0" Foreground="#55FFFFFF"
                        FontSize="14" FontWeight="Bold" Margin="0 -8 -4 0" Cursor="Hand"
                        Click="Hide_Click" ToolTip="Hide Overlay" Panel.ZIndex="10"/>

                <!-- Resource Stats Grid -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CPU " Foreground="#88FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CpuText}" Foreground="White" FontSize="10" FontWeight="Bold" Margin="0 0 12 0"/>

                        <TextBlock Text="RAM " Foreground="#88FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RamText}" Foreground="White" FontSize="10" FontWeight="Bold" Margin="0 0 12 0"/>

                        <TextBlock Text="GPU " Foreground="#88FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GpuText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="1" Text="{Binding ActiveModelName}" Foreground="#FF00FFFF" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Throughput Badge -->
                <Border Grid.Column="1" Background="#22512BD4" CornerRadius="6" Padding="6 4" VerticalAlignment="Center" Margin="10 0 0 0">
                    <TextBlock Text="{Binding ThroughputText}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. EXPANDED OVERLAY VIEW -->
        <Border Style="{StaticResource OverlayCard}" 
                Margin="10"
                Visibility="{Binding ExpandedVisibility}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Tabs (If Multiple Active) -->
                    <RowDefinition Height="*"/>    <!-- Runtime Panel -->
                    <RowDefinition Height="Auto"/> <!-- Rolling Trends -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0 0 0 10">
                    <TextBlock Text="ModelPulse Monitor" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Collapse" Style="{StaticResource HeaderButton}" Click="Collapse_Click"/>
                        <Button Content="Hide" Style="{StaticResource HeaderButton}" Margin="10 0 0 0" Click="Hide_Click" ToolTip="Hide Overlay"/>
                    </StackPanel>
                </Grid>

                <!-- Tabs (if multiple runtimes are active) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 10" Visibility="{Binding IsMultipleRuntimesActive, Converter={StaticResource BoolToVis}}">
                    <RadioButton Content="Ollama" IsChecked="{Binding IsOllamaSelected}" Style="{StaticResource ModernTabButton}" GroupName="Runtimes" Margin="0 0 10 0" Cursor="Hand"/>
                    <RadioButton Content="llama.cpp" IsChecked="{Binding IsLlamaCppSelected}" Style="{StaticResource ModernTabButton}" GroupName="Runtimes" Cursor="Hand"/>
                </StackPanel>

                <!-- Runtime Details Panel -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0 0 0 10">
                    <StackPanel>
                        <!-- Ollama Panel -->
                        <StackPanel Visibility="{Binding IsOllamaSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="OLLAMA RUNTIME" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold" Margin="0 0 0 6"/>
                            <Grid Margin="0 0 0 10">
                                <TextBlock Text="Version:" Foreground="#88FFFFFF" FontSize="11"/>
                                <TextBlock Text="{Binding OllamaVersion}" Foreground="White" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="LOADED MODEL" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold" Margin="0 0 0 6"/>
                            <Border Background="#11FFFFFF" Padding="10" CornerRadius="6" Margin="0 0 0 10">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveModelName}" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0 0 0 4"/>
                                    <Grid Margin="0 0 0 4">
                                        <TextBlock Text="VRAM Used:" Foreground="#88FFFFFF" FontSize="11"/>
                                        <TextBlock Text="{Binding ModelVramText}" Foreground="White" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0 0 0 4">
                                        <TextBlock Text="Context Length:" Foreground="#88FFFFFF" FontSize="11"/>
                                        <TextBlock Text="{Binding ContextLengthText}" Foreground="White" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Unload Timer:" Foreground="#88FFFFFF" FontSize="11"/>
                                        <TextBlock Text="{Binding UnloadTimerText}" Foreground="#FF00FFFF" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="PERFORMANCE" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold" Margin="0 0 0 6"/>
                            <Grid>
                                <TextBlock Text="Throughput:" Foreground="#88FFFFFF" FontSize="11"/>
                                <TextBlock Text="{Binding ThroughputText}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Llama.cpp Panel -->
                        <StackPanel Visibility="{Binding IsLlamaCppSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="LLAMA.CPP RUNTIME" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold" Margin="0 0 0 6"/>
                            <Grid Margin="0 0 0 10">
                                <TextBlock Text="Version:" Foreground="#88FFFFFF" FontSize="11"/>
                                <TextBlock Text="{Binding LlamaCppVersion}" Foreground="White" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="SERVER DETAILS" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold" Margin="0 0 0 6"/>
                            <Border Background="#11FFFFFF" Padding="10" CornerRadius="6" Margin="0 0 0 10">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveModelName}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="PERFORMANCE" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold" Margin="0 0 0 6"/>
                            <Grid>
                                <TextBlock Text="Server Status:" Foreground="#88FFFFFF" FontSize="11"/>
                                <TextBlock Text="{Binding ThroughputText}" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Rolling Trends (Last 5 Minutes) -->
                <Border Grid.Row="3" Background="#11FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="0 1 0 0" Padding="0 10 0 0">
                    <StackPanel>
                        <TextBlock Text="LAST 5 MINUTES TRENDS" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold" Margin="0 0 0 8"/>
                        <UniformGrid Columns="2" Rows="2">
                            <StackPanel Margin="0 0 0 6">
                                <TextBlock Text="CPU Avg" Foreground="#88FFFFFF" FontSize="9"/>
                                <TextBlock Text="{Binding HistoryCpuAvg}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0 0 0 6">
                                <TextBlock Text="RAM Avg" Foreground="#88FFFFFF" FontSize="9"/>
                                <TextBlock Text="{Binding HistoryRamAvg}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="GPU Avg" Foreground="#88FFFFFF" FontSize="9"/>
                                <TextBlock Text="{Binding HistoryGpuAvg}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Pressure Events" Foreground="#88FFFFFF" FontSize="9"/>
                                <TextBlock Text="{Binding HistoryPressureEvents}" Foreground="#FFFF5555" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
